{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Factory unit or company entity.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "description": "Unique company identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Company display name",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": ["companyId", "name"]
    },
    "BankDetails": {
      "title": "BankDetails",
      "description": "Employee bank account details for payroll export.",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 40 },
        "ifscCode": { "type": "string", "maxLength": 20 },
        "beneficiaryName": { "type": "string", "maxLength": 120 }
      }
    },
    "Worker": {
      "title": "Worker",
      "description": "Factory worker, admin staff, or other staff record.",
      "type": "object",
      "properties": {
        "workerId": {
          "type": "string",
          "description": "Unique employee code",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Employee full name",
          "minLength": 1,
          "maxLength": 120
        },
        "mobileNumber": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "joiningDate": { "type": "string", "maxLength": 20 },
        "bankDetails": { "$ref": "#/entities/BankDetails" },
        "aadhaarNumber": { "type": "string", "maxLength": 30 },
        "isActive": { "type": "boolean" },
        "perMachineRate": { "type": "number" },
        "monthlySalary": { "type": "number" },
        "monthlyDays": { "type": "number" },
        "employeeType": {
          "type": "string",
          "enum": ["Worker", "Admin Employee", "Others"]
        },
        "companyName": { "type": "string", "maxLength": 120 }
      },
      "required": ["workerId", "name", "isActive", "perMachineRate", "employeeType", "companyName"]
    },
    "Machine": {
      "title": "Machine",
      "description": "Weaving loom machine definition.",
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string",
          "description": "Unique machine identifier",
          "minLength": 1,
          "maxLength": 64
        },
        "isActive": { "type": "boolean" },
        "companyName": { "type": "string", "maxLength": 120 }
      },
      "required": ["machineId", "isActive", "companyName"]
    },
    "DailyWork": {
      "title": "DailyWork",
      "description": "Loom worker daily shift production entry.",
      "type": "object",
      "properties": {
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "selectedMachines": { "type": "array" },
        "machineCount": { "type": "number" },
        "perMachineRate": { "type": "number" },
        "calculatedWage": { "type": "number" },
        "shift": { "type": "string", "enum": ["Day", "Night"] }
      },
      "required": ["workId", "workerId", "date", "selectedMachines", "machineCount", "perMachineRate", "calculatedWage", "shift"]
    },
    "DailyWorkLock": {
      "title": "DailyWorkLock",
      "description": "Atomic concurrency lock preventing duplicate operator shift entries and machine double-booking.",
      "type": "object",
      "properties": {
        "lockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lockType": { "type": "string", "enum": ["worker", "machine"] },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "shift": { "type": "string", "enum": ["Day", "Night"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["lockId", "lockType", "workId", "date", "shift", "targetId"]
    },
    "AdminAttendance": {
      "title": "AdminAttendance",
      "description": "Daily shift attendance record for Admin and Other staff.",
      "type": "object",
      "properties": {
        "adminAttendanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": { "type": "string", "enum": ["Present", "Absent", "Half-Day"] },
        "calculatedWage": { "type": "number" },
        "shift": { "type": "string", "enum": ["Day", "Night"] }
      },
      "required": ["adminAttendanceId", "workerId", "date", "status", "calculatedWage"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Loom operator shift attendance register record.",
      "type": "object",
      "properties": {
        "attendanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": { "type": "string", "enum": ["Present", "Absent", "Half-Day"] },
        "inTime": { "type": "string", "maxLength": 20 },
        "outTime": { "type": "string", "maxLength": 20 },
        "shift": { "type": "string", "enum": ["Day", "Night"] }
      },
      "required": ["attendanceId", "workerId", "date", "status"]
    },
    "Salary": {
      "title": "Salary",
      "description": "Monthly payroll ledger entry for an employee.",
      "type": "object",
      "properties": {
        "salaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workerId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "baseSalary": { "type": "number" },
        "bonus": { "type": "number" },
        "advance": { "type": "number" },
        "deductions": { "type": "number" },
        "netSalary": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Paid"] }
      },
      "required": ["salaryId", "workerId", "month", "baseSalary", "bonus", "advance", "deductions", "netSalary", "status"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Registered textile factory companies."
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Employee master directory."
    },
    "/machines/{machineId}": {
      "schema": { "$ref": "#/entities/Machine" },
      "description": "Loom machine registry."
    },
    "/daily_works/{workId}": {
      "schema": { "$ref": "#/entities/DailyWork" },
      "description": "Daily loom operator production logs."
    },
    "/daily_work_locks/{lockId}": {
      "schema": { "$ref": "#/entities/DailyWorkLock" },
      "description": "Transactional uniqueness locks for worker-shift and machine-shift production entries."
    },
    "/admin_attendances/{attendanceId}": {
      "schema": { "$ref": "#/entities/AdminAttendance" },
      "description": "Admin and Other staff daily attendance records."
    },
    "/attendances/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Loom operator attendance records."
    },
    "/salaries/{salaryId}": {
      "schema": { "$ref": "#/entities/Salary" },
      "description": "Monthly salary calculations and payment status."
    }
  }
}
